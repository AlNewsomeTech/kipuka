{
  "name": "CompanyProfile",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "The Organization (tenant) this company profile belongs to. One profile per organization."
    },
    "company_name": {
      "type": "string"
    },
    "cage_code": {
      "type": "string"
    },
    "duns_uei": {
      "type": "string",
      "description": "DUNS number or SAM.gov Unique Entity ID (UEI)."
    },
    "dod_contracts": {
      "type": "string",
      "description": "DoD contracts currently held or being pursued (free text or list)."
    },
    "employee_count": {
      "type": "number",
      "default": 0
    },
    "it_environment": {
      "type": "string",
      "enum": [
        "Microsoft 365 Commercial",
        "Microsoft 365 GCC",
        "Microsoft 365 GCC High",
        "Google Workspace",
        "On-Premises",
        "Hybrid",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "implementation_stack": {
      "type": "string",
      "enum": [
        "Microsoft 365 Commercial",
        "Microsoft 365 GCC",
        "Microsoft 365 GCC High",
        "Google Workspace",
        "Hybrid/Other"
      ],
      "default": "Microsoft 365 Commercial",
      "description": "The primary implementation tech stack. Seeded from the onboarding wizard IT environment answer. Drives which runbook instruction variant is shown by default."
    },
    "uses_msp": {
      "type": "boolean",
      "default": false,
      "description": "Whether the company uses a Managed Service Provider (MSP)."
    },
    "msp_name": {
      "type": "string"
    },
    "has_existing_ssp": {
      "type": "boolean",
      "default": false,
      "description": "Whether the company already has a System Security Plan (SSP)."
    },
    "cmmc_track": {
      "type": "string",
      "enum": [
        "Level 1",
        "Level 2",
        "Undetermined"
      ],
      "default": "Undetermined",
      "description": "The CMMC track determined by the scoping questionnaire. Drives which control set is shown org-wide."
    },
    "active_project_id": {
      "type": "string",
      "description": "The default implementation Project the org-level dashboard, SPRS widget, and progress views read from and write to."
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "Not Started",
        "Company Setup",
        "Scoping",
        "Complete"
      ],
      "default": "Not Started",
      "description": "Tracks progress through the first-run onboarding wizard."
    },
    "onboarding_completed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "company_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        },
        {
          "user_condition": {
            "role": "client"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}