{
  "name": "MicrosoftTenantCredential",
  "type": "object",
  "description": "Service-only storage for a customer organization's own Entra app registration client credential (client-credentials flow). Read and write are BOTH service-only: no browser session \u2014 including platform admins \u2014 can read this entity through the SDK. Raw OAuth access tokens are never stored; they are acquired on demand inside backend functions and discarded. One active credential per organization; replaced credentials are deactivated, never reused.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_secret": {
      "type": "string",
      "description": "Customer-supplied app registration client secret. Service-only readable."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_by_email": {
      "type": "string"
    },
    "deactivated_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "tenant_id",
    "client_id",
    "client_secret"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}