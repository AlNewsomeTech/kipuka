{
  "name": "GeneratedDocument",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body_content": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "owner": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "control_mappings": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "In Review",
        "Approved",
        "Published"
      ],
      "default": "Draft"
    },
    "include_in_final_package": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "title"
  ]
}