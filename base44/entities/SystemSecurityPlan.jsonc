{
  "name": "SystemSecurityPlan",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "ssp_title": {
      "type": "string"
    },
    "system_name": {
      "type": "string"
    },
    "system_description": {
      "type": "string"
    },
    "system_purpose": {
      "type": "string"
    },
    "authorization_boundary": {
      "type": "string"
    },
    "environment_description": {
      "type": "string"
    },
    "cui_description": {
      "type": "string"
    },
    "fci_description": {
      "type": "string"
    },
    "user_population": {
      "type": "string"
    },
    "asset_summary": {
      "type": "string"
    },
    "network_summary": {
      "type": "string"
    },
    "cloud_services_summary": {
      "type": "string"
    },
    "external_service_provider_summary": {
      "type": "string"
    },
    "roles_and_responsibilities": {
      "type": "string"
    },
    "inherited_controls_summary": {
      "type": "string"
    },
    "shared_responsibility_summary": {
      "type": "string"
    },
    "control_implementation_summary": {
      "type": "string"
    },
    "linked_poam_summary": {
      "type": "string"
    },
    "revision_history": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Draft",
        "In Review",
        "Approved",
        "Archived"
      ],
      "default": "Draft"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    }
  },
  "required": [
    "project_id",
    "ssp_title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}