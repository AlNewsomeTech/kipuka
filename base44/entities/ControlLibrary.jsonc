{
  "name": "ControlLibrary",
  "type": "object",
  "properties": {
    "framework": {
      "type": "string",
      "enum": [
        "CMMC",
        "NIST SP 800-171",
        "FAR 52.204-21"
      ],
      "default": "CMMC"
    },
    "cmmc_level": {
      "type": "string",
      "enum": [
        "Level 1",
        "Level 2",
        "Level 3",
        "Not Applicable"
      ],
      "default": "Level 1"
    },
    "domain": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "control_title": {
      "type": "string"
    },
    "requirement_text": {
      "type": "string"
    },
    "plain_english_summary": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string",
      "description": "Plain-English 'why this matters' shown in the guided walkthrough UNDERSTAND step (max ~3 short sentences)."
    },
    "assessment_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "example_implementation": {
      "type": "string"
    },
    "example_evidence": {
      "type": "string"
    },
    "how_to_implement": {
      "type": "object",
      "description": "Per-implementation-stack how-to variants keyed by stack: m365_commercial, m365_gcc, m365_gcc_high, google_workspace, generic. Each variant is an object with: where_to_go {name, url}, steps (array of ordered click-by-click strings), setting_to_change (string), screenshot_instructions (string), screenshot_naming (string, CONTROLID_ToolName_Description_YYYY-MM-DD convention), validation_steps (array of strings), common_mistakes (array of strings).",
      "default": {}
    },
    "estimated_minutes": {
      "type": "integer",
      "default": 15,
      "description": "Rough time estimate for the guided walkthrough time badge. Defaults derived from SPRS point value (5pt~30, 3pt~20, 1pt~15) and adjustable per control."
    },
    "related_policy_templates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ssp_statement_starter": {
      "type": "string"
    },
    "poam_gap_starter": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "control_id",
    "control_title"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}