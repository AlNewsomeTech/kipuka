{
  "name": "ControlLibrary",
  "type": "object",
  "properties": {
    "framework": {
      "type": "string",
      "enum": [
        "CMMC",
        "NIST SP 800-171",
        "FAR 52.204-21"
      ],
      "default": "CMMC"
    },
    "cmmc_level": {
      "type": "string",
      "enum": [
        "Level 1",
        "Level 2",
        "Level 3",
        "Not Applicable"
      ],
      "default": "Level 1"
    },
    "domain": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "control_title": {
      "type": "string"
    },
    "requirement_text": {
      "type": "string"
    },
    "plain_english_summary": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string",
      "description": "Plain-English 'why this matters' shown in the guided walkthrough UNDERSTAND step (max ~3 short sentences)."
    },
    "assessment_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "example_implementation": {
      "type": "string"
    },
    "example_evidence": {
      "type": "string"
    },
    "how_to_implement": {
      "type": "object",
      "description": "Per-environment structured runbooks. Each variant includes outcome, responsible_role, before_you_start, where_to_go {name, url}, ordered click-by-click steps, optional policy_names [{label, policy_type, location}] rendered as CompanyName_PolicyType_CONTROLID_ControlLocation_YYYY-MM-DD, setting_to_change, kipuka_actions, screenshot_instructions, screenshot_naming using CompanyName_ControlType_CONTROLID_ToolName_Description_YYYY-MM-DD, validation_steps, and common_mistakes.",
      "default": {}
    },
    "estimated_minutes": {
      "type": "integer",
      "default": 15,
      "description": "Rough time estimate for the guided walkthrough time badge. Defaults derived from SPRS point value (5pt~30, 3pt~20, 1pt~15) and adjustable per control."
    },
    "related_policy_templates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ssp_statement_starter": {
      "type": "string"
    },
    "poam_gap_starter": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "dataset_key": {
      "type": "string",
      "description": "Versioned authoritative dataset this record belongs to, e.g. CMMC-2.13-SP800-171R2-2024-09."
    },
    "dataset_version": {
      "type": "string"
    },
    "source_requirement_id": {
      "type": "string",
      "description": "Numeric NIST SP 800-171 requirement this record derives from, e.g. 3.1.1."
    },
    "source_document": {
      "type": "string"
    },
    "source_version": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "crosswalk_requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "All NIST requirement IDs mapped to this control (e.g. PE.L1-b.1.ix maps 3.10.3, 3.10.4, 3.10.5)."
    },
    "content_sha256": {
      "type": "string"
    },
    "authoritative": {
      "type": "boolean",
      "default": false,
      "description": "True when requirement text and metadata came from the versioned authoritative import rather than hand-authored seed data."
    },
    "superseded_by_control_id": {
      "type": "string",
      "description": "Set on legacy records when a newer dataset supersedes them. Legacy records are deactivated, never deleted."
    }
  },
  "required": [
    "control_id",
    "control_title"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}