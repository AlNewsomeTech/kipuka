{
  "name": "Organization",
  "type": "object",
  "properties": {
    "organization_name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "short_name": {
      "type": "string"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string",
      "format": "email"
    },
    "primary_contact_phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "uei": {
      "type": "string"
    },
    "cage_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "sam_registration_status": {
      "type": "string",
      "enum": [
        "Unknown",
        "Active",
        "Inactive",
        "Pending",
        "Not Applicable"
      ],
      "default": "Unknown"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "Starter L1",
        "Professional L2",
        "Premium L2 Readiness",
        "Pac-Sec Managed",
        "Trial"
      ],
      "default": "Trial"
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "L1_Essentials",
        "L1_Complete",
        "L2_Professional",
        "L2_Premium",
        "Enterprise"
      ],
      "default": "L1_Essentials",
      "description": "Platform capability tier. Set ONLY by the platform super-admin from the consultant console. Gates which platform features are available. Not a description of any managed service or labor."
    },
    "trial_full_access": {
      "type": "boolean",
      "default": false,
      "description": "When true, the org gets full-featured access regardless of plan_tier (14-day self-service trial). Super-admin sets the real tier once the trial ends."
    },
    "trial_ends_date": {
      "type": "string",
      "format": "date",
      "description": "Date the 14-day full-featured trial ends. After this date the plan_tier gate applies even if trial_full_access is still true."
    },
    "acolyte_tier": {
      "type": "string",
      "enum": [
        "none",
        "watch",
        "ready",
        "shield",
        "cmmc_premium"
      ],
      "default": "none",
      "description": "ACOLYTE Operations managed-service entitlement. Super-admin set. 'none' shows a locked preview of the service."
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "Trial",
        "Active",
        "Past Due",
        "Suspended",
        "Cancelled"
      ],
      "default": "Trial"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date"
    },
    "seat_limit": {
      "type": "integer",
      "default": 5
    },
    "storage_limit_gb": {
      "type": "number",
      "default": 5
    },
    "support_level": {
      "type": "string",
      "enum": [
        "Standard",
        "Priority",
        "Pac-Sec Managed"
      ],
      "default": "Standard"
    },
    "customer_logo_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "fully_disabled": {
      "type": "boolean",
      "default": false,
      "description": "When true (set by Pac-Sec Admin), the organization has no access at all \u2014 not even read-only."
    }
  },
  "required": [
    "organization_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}