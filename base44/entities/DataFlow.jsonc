{
  "name": "DataFlow",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "flow_name": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "destination_system": {
      "type": "string"
    },
    "data_type": {
      "type": "string",
      "enum": [
        "FCI",
        "CUI",
        "Non-FCI",
        "Mixed"
      ],
      "default": "FCI"
    },
    "protocol": {
      "type": "string"
    },
    "encryption_in_transit": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    },
    "related_controls": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "flow_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}