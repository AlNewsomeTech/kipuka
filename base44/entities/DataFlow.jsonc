{
  "name": "DataFlow",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "flow_name": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "destination_system": {
      "type": "string"
    },
    "data_type": {
      "type": "string",
      "enum": [
        "FCI",
        "CUI",
        "Non-FCI",
        "Mixed"
      ],
      "default": "FCI"
    },
    "protocol": {
      "type": "string"
    },
    "encryption_in_transit": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    },
    "related_controls": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "flow_name"
  ]
}