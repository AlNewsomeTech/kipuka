{
  "name": "TechnicianRunbookProgress",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "tool_name": {
      "type": "string",
      "enum": [
        "NinjaOne",
        "Palo Alto Cortex XDR",
        "Other"
      ],
      "default": "NinjaOne"
    },
    "runbook_section": {
      "type": "string"
    },
    "step_title": {
      "type": "string"
    },
    "step_status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Complete",
        "Needs Review",
        "Blocked"
      ],
      "default": "Not Started"
    },
    "completed_by": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "linked_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "related_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "project_id",
    "tool_name",
    "runbook_section",
    "step_title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}