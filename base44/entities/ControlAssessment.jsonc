{
  "name": "ControlAssessment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "control_title": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "cmmc_level": {
      "type": "string",
      "enum": [
        "Level 1",
        "Level 2",
        "Level 3"
      ],
      "default": "Level 1"
    },
    "status": {
      "type": "string",
      "enum": [
        "Not Started",
        "Implementation Planned",
        "Implementation In Progress",
        "Implemented Pending Evidence",
        "Evidence Uploaded",
        "Evidence Needs Review",
        "Evidence Accepted",
        "Gap Identified",
        "POA&M Linked",
        "Ready for Documentation",
        "Implemented",
        "Partially Implemented",
        "Not Implemented",
        "Not Applicable",
        "Needs Review",
        "Ready for Assessment"
      ],
      "default": "Not Started"
    },
    "implementation_summary": {
      "type": "string"
    },
    "ssp_statement": {
      "type": "string"
    },
    "inherited_control_source": {
      "type": "string"
    },
    "responsible_owner": {
      "type": "string"
    },
    "evidence_required": {
      "type": "string"
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "No Evidence",
        "Evidence Uploaded",
        "Needs Better Evidence",
        "Accepted",
        "Expired"
      ],
      "default": "No Evidence"
    },
    "risk_rating": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Critical"
      ],
      "default": "Moderate"
    },
    "assessor_notes": {
      "type": "string"
    },
    "pacsec_internal_notes": {
      "type": "string"
    },
    "not_applicable_justification": {
      "type": "string",
      "description": "Required plain-language explanation of why the security requirement does not apply within the documented CMMC assessment scope."
    },
    "not_applicable_scope_evidence": {
      "type": "string",
      "description": "Scope artifacts or records that support the Not Applicable finding, such as diagrams, inventories, SSP sections, or provider responsibility records."
    },
    "not_applicable_confirmed_by": {
      "type": "string"
    },
    "not_applicable_confirmed_date": {
      "type": "string",
      "format": "date"
    },
    "not_applicable_previous_status": {
      "type": "string",
      "description": "The prior status restored if the control becomes applicable again."
    },
    "not_applicable_request_id": {
      "type": "string",
      "description": "The latest service-created applicability request."
    },
    "not_applicable_request_status": {
      "type": "string",
      "enum": [
        "Pending Review",
        "Approved",
        "Rejected",
        "Withdrawn",
        "Restored"
      ],
      "description": "Server-controlled workflow state. Pending or legacy records never earn readiness credit."
    },
    "not_applicable_decision_sha256": {
      "type": "string",
      "description": "SHA-256 of the independently approved applicability decision."
    },
    "not_applicable_approved_by_email": {
      "type": "string",
      "format": "email"
    },
    "not_applicable_approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "not_applicable_last_transition_id": {
      "type": "string",
      "description": "Last server-controlled applicability transition, used for idempotent recovery."
    },
    "not_applicable_last_transition_input_sha256": {
      "type": "string",
      "description": "SHA-256 of the last applicability transition input, used to reject conflicting retries."
    },
    "last_reviewed_by": {
      "type": "string"
    },
    "last_reviewed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "project_id",
    "control_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}