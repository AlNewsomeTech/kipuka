{
  "name": "ControlApplicabilityRequest",
  "type": "object",
  "description": "Project-scoped request for an independently reviewed control Not Applicable determination. Browser writes are prohibited.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "control_assessment_id": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "request_version": {
      "type": "integer",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending Review",
        "Approved",
        "Rejected",
        "Withdrawn",
        "Superseded"
      ],
      "default": "Pending Review"
    },
    "justification": {
      "type": "string"
    },
    "scope_evidence": {
      "type": "string"
    },
    "scope_confirmation": {
      "type": "boolean",
      "default": false
    },
    "previous_assessment_status": {
      "type": "string"
    },
    "source_assessment_sha256": {
      "type": "string"
    },
    "request_sha256": {
      "type": "string"
    },
    "decision_sha256": {
      "type": "string"
    },
    "submitted_by_user_id": {
      "type": "string"
    },
    "submitted_by_email": {
      "type": "string"
    },
    "submitted_by_name": {
      "type": "string"
    },
    "submitted_by_role": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "reviewed_by_email": {
      "type": "string"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "reviewed_by_role": {
      "type": "string"
    },
    "review_note": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_transition_id": {
      "type": "string"
    },
    "last_transition_input_sha256": {
      "type": "string"
    },
    "supersedes_request_id": {
      "type": "string"
    },
    "superseded_by_request_id": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "project_id",
    "control_assessment_id",
    "control_id",
    "request_version",
    "status",
    "justification",
    "scope_evidence",
    "source_assessment_sha256",
    "request_sha256",
    "submitted_by_email",
    "submitted_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}