{
  "name": "ProjectEvidence",
  "type": "object",
  "description": "Canonical, versioned Project evidence with server-verified file integrity, provenance, review, retention, and supersession.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_title": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "Screenshot",
        "Policy",
        "Procedure",
        "Configuration Export",
        "Report",
        "Ticket",
        "Interview Note",
        "Diagram",
        "Log",
        "Attestation",
        "Other"
      ],
      "default": "Screenshot"
    },
    "source_tool": {
      "type": "string",
      "description": "Organization-configured source tool or system label.",
      "default": "None"
    },
    "file_uri": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Retired legacy public URL. New canonical records use private file_uri."
    },
    "file_name": {
      "type": "string"
    },
    "original_file_name": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "file_size_bytes": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "evidence_date": {
      "type": "string",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "retention_until": {
      "type": "string",
      "format": "date"
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploaded_by_user_id": {
      "type": "string"
    },
    "uploaded_by_email": {
      "type": "string"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Needs Review",
        "Accepted",
        "Rejected",
        "Expired",
        "Archived",
        "Superseded"
      ],
      "default": "Draft"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewer_user_id": {
      "type": "string"
    },
    "reviewer_email": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_note": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "quality_notes": {
      "type": "string"
    },
    "quality_checklist": {
      "type": "object",
      "default": {}
    },
    "hash_algorithm": {
      "type": "string",
      "enum": [
        "SHA-256"
      ],
      "default": "SHA-256"
    },
    "hash_value": {
      "type": "string"
    },
    "hash_verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "metadata_sha256": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "provenance_type": {
      "type": "string",
      "enum": [
        "Manual Upload",
        "System Export",
        "Screenshot",
        "Policy Record",
        "Procedure Record",
        "Third-Party Attestation",
        "Tool Export",
        "API Import",
        "Generated"
      ],
      "default": "Manual Upload"
    },
    "provenance_details": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "default": 1
    },
    "supersedes_evidence_id": {
      "type": "string"
    },
    "superseded_by_evidence_id": {
      "type": "string"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "Current",
        "Superseded",
        "Archived"
      ],
      "default": "Current"
    },
    "last_transition_id": {
      "type": "string"
    },
    "last_transition_action": {
      "type": "string"
    },
    "last_transition_from_status": {
      "type": "string"
    },
    "last_transition_to_status": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "project_id",
    "evidence_title",
    "review_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}