{
  "name": "MockAssessmentObjective",
  "type": "object",
  "description": "One assessment-objective verdict within a mock assessment session (NIST SP 800-171A objective-level).",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "control_title": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "objective_id": {
      "type": "string",
      "description": "e.g. 3.1.1[a]"
    },
    "objective_text": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "Not Assessed",
        "Met",
        "Not Met",
        "Not Applicable"
      ],
      "default": "Not Assessed"
    },
    "justification": {
      "type": "string",
      "description": "Required justification for NOT MET / NOT APPLICABLE verdicts."
    },
    "assessor_notes": {
      "type": "string"
    },
    "linked_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "poam_created": {
      "type": "boolean",
      "default": false,
      "description": "Whether a POA&M item was created from this failed objective."
    }
  },
  "required": [
    "project_id",
    "session_id",
    "objective_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}