{
  "name": "SSPGenerationRun",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "ssp_record_id": {
      "type": "string"
    },
    "run_level": {
      "type": "string",
      "enum": [
        "Level 1",
        "Level 2 Ready",
        "Level 2"
      ],
      "default": "Level 1"
    },
    "run_status": {
      "type": "string",
      "enum": [
        "Running",
        "Complete",
        "Failed"
      ],
      "default": "Complete"
    },
    "completeness_score": {
      "type": "number",
      "default": 0
    },
    "control_narrative_completeness": {
      "type": "number",
      "default": 0
    },
    "evidence_linkage_completeness": {
      "type": "number",
      "default": 0
    },
    "inventory_completeness": {
      "type": "number",
      "default": 0
    },
    "policy_completeness": {
      "type": "number",
      "default": 0
    },
    "level1_readiness": {
      "type": "number",
      "default": 0
    },
    "level2_readiness": {
      "type": "number",
      "default": 0
    },
    "final_package_readiness": {
      "type": "number",
      "default": 0
    },
    "gaps_found": {
      "type": "string"
    },
    "placeholders_found": {
      "type": "string"
    },
    "duplicates_found": {
      "type": "string"
    },
    "client_mismatches_found": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "run_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "client_id"
  ]
}