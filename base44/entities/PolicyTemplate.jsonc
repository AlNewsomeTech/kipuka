{
  "name": "PolicyTemplate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "policy_name": {
      "type": "string"
    },
    "policy_category": {
      "type": "string"
    },
    "mapped_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "policy_body": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "owner": {
      "type": "string"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Template",
        "Draft",
        "In Review",
        "Approved",
        "Archived"
      ],
      "default": "Template"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "is_master_template": {
      "type": "boolean",
      "default": false,
      "description": "True for the seeded library master templates (no project_id). Users clone these into a project."
    }
  },
  "required": [
    "policy_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        },
        {
          "user_condition": {
            "role": "client"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}