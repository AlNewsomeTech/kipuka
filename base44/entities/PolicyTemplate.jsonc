{
  "name": "PolicyTemplate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "policy_name": {
      "type": "string"
    },
    "policy_category": {
      "type": "string"
    },
    "mapped_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "policy_body": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "owner": {
      "type": "string"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Template",
        "Draft",
        "In Review",
        "Approved",
        "Archived"
      ],
      "default": "Template"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "is_master_template": {
      "type": "boolean",
      "default": false,
      "description": "True for the seeded library master templates (no project_id). Users clone these into a project."
    },
    "family_code": {
      "type": "string",
      "description": "Two-letter NIST 800-171 family code (AC, AT, AU, ...) for family coverage auditing."
    },
    "doc_kind": {
      "type": "string",
      "enum": [
        "Policy",
        "Procedure",
        ""
      ],
      "default": "",
      "description": "Whether this document is a Policy or a Procedure, for full-family coverage."
    },
    "unresolved_placeholders": {
      "type": "string",
      "description": "Comma-separated list of {{merge}} variables left unresolved when this policy was cloned/imported (e.g. from a missing CompanyProfile field)."
    },
    "unresolved_placeholders_count": {
      "type": "number",
      "default": 0,
      "description": "Count of unresolved {{merge}} placeholders \u2014 surfaced so nothing ships blank."
    }
  },
  "required": [
    "policy_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}