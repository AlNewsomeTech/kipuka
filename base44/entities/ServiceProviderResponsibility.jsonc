{
  "name": "ServiceProviderResponsibility",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "Cloud Provider",
        "MSP",
        "Security Tool",
        "Email Provider",
        "Other"
      ],
      "default": "Cloud Provider"
    },
    "services_used": {
      "type": "string"
    },
    "cmmc_controls_supported": {
      "type": "string"
    },
    "client_responsibilities": {
      "type": "string"
    },
    "provider_responsibilities": {
      "type": "string"
    },
    "shared_responsibilities": {
      "type": "string"
    },
    "inheritance_notes": {
      "type": "string"
    },
    "agreement_reference": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Planned",
        "Under Review"
      ],
      "default": "Active"
    }
  },
  "required": [
    "client_id",
    "provider_name"
  ]
}