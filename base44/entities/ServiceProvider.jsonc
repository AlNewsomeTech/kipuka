{
  "name": "ServiceProvider",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "External Service Provider (ESP)",
        "Cloud Service Provider (CSP)",
        "Managed Service Provider (MSP)",
        "SaaS Application",
        "Other"
      ],
      "default": "External Service Provider (ESP)"
    },
    "service_description": {
      "type": "string"
    },
    "prefill_template": {
      "type": "string",
      "enum": [
        "None",
        "Microsoft 365 GCC High",
        "Microsoft 365 GCC",
        "Microsoft 365 Commercial",
        "Google Workspace",
        "Generic MSP"
      ],
      "default": "None"
    },
    "fedramp_status": {
      "type": "string",
      "enum": [
        "Not Applicable",
        "FedRAMP Moderate",
        "FedRAMP High",
        "FedRAMP Equivalent",
        "DoD IL4",
        "DoD IL5",
        "Unknown"
      ],
      "default": "Unknown"
    },
    "asset_id": {
      "type": "string",
      "description": "Optional linked Asset this provider was suggested from."
    },
    "responsibilities": {
      "type": "array",
      "description": "Per-control responsibility mapping. Each: { control_id, control_title, responsibility (Customer|Provider|Shared|Not Applicable), inheritance_notes }",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "provider_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        },
        {
          "user_condition": {
            "role": "client"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}