{
  "name": "POAMItem",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "weakness_description": {
      "type": "string"
    },
    "remediation_plan": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "default": "Medium"
    },
    "scheduled_completion": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "In Progress",
        "Closed"
      ],
      "default": "Open"
    },
    "owner": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "weakness_description"
  ]
}