{
  "name": "MicrosoftPolicyDeployment",
  "type": "object",
  "description": "A customer-tenant deployment of a canonical MicrosoftPolicyDefinition, created and updated exclusively by the manageMicrosoftDeployment backend function (service-only writes). Tracks the full precheck \u2192 approval \u2192 deploy \u2192 read-back verification lifecycle, frozen original policy naming date, before/after evidence, rollback snapshot, and drift state. Only KIPUKA-MANAGED objects get a record; discovered existing Microsoft policies are never claimed.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "policy_definition_id": {
      "type": "string"
    },
    "definition_key": {
      "type": "string"
    },
    "definition_version": {
      "type": "string"
    },
    "definition_sha256": {
      "type": "string"
    },
    "microsoft_service": {
      "type": "string"
    },
    "graph_resource_type": {
      "type": "string"
    },
    "graph_endpoint": {
      "type": "string"
    },
    "graph_object_id": {
      "type": "string",
      "description": "Microsoft Graph object ID stored after successful creation. All future updates PATCH this ID \u2014 never a new object because the calendar date changed."
    },
    "deployed_display_name": {
      "type": "string",
      "description": "Name generated by the existing Kipuka naming engine with the date FROZEN to the original deployment date."
    },
    "primary_control_id": {
      "type": "string"
    },
    "related_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "related_objective_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "Precheck Required",
        "Ready for Approval",
        "Deploying",
        "Deployed Pending Verification",
        "Verified",
        "Verification Failed",
        "Conflict Detected",
        "Rolled Back",
        "Failed"
      ],
      "default": "Precheck Required"
    },
    "deployment_mode": {
      "type": "string",
      "enum": [
        "report_only",
        "enabled",
        "create_unassigned"
      ],
      "default": "report_only"
    },
    "assignment_summary": {
      "type": "string"
    },
    "exclusion_summary": {
      "type": "string"
    },
    "proposed_configuration": {
      "type": "object",
      "default": {},
      "description": "Exact desired Graph payload captured at precheck; the approval hash covers this."
    },
    "current_configuration": {
      "type": "object",
      "default": {},
      "description": "Tenant state read during the most recent precheck (existing managed object, or null state for new objects)."
    },
    "diff_summary": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "desired_sha256": {
      "type": "string"
    },
    "actual_sha256": {
      "type": "string",
      "description": "SHA-256 of the read-back configuration projected onto the desired shape."
    },
    "precheck_date": {
      "type": "string",
      "format": "date-time"
    },
    "precheck_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "original_deployment_date": {
      "type": "string",
      "format": "date",
      "description": "Frozen date used in the Microsoft policy name; never changes on updates."
    },
    "deployed_by": {
      "type": "string"
    },
    "verified_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_date": {
      "type": "string",
      "format": "date-time"
    },
    "before_evidence_id": {
      "type": "string"
    },
    "after_evidence_id": {
      "type": "string"
    },
    "rollback_snapshot_uri": {
      "type": "string",
      "description": "Private-storage URI of the verified pre-change configuration snapshot."
    },
    "rollback_snapshot_sha256": {
      "type": "string"
    },
    "rollback_available": {
      "type": "boolean",
      "default": false,
      "description": "True only when a verified pre-change snapshot exists to restore."
    },
    "rolled_back_by": {
      "type": "string"
    },
    "rolled_back_date": {
      "type": "string",
      "format": "date-time"
    },
    "drift_status": {
      "type": "string",
      "enum": [
        "Unknown",
        "In Sync",
        "Drift Detected"
      ],
      "default": "Unknown"
    },
    "last_drift_check": {
      "type": "string",
      "format": "date-time"
    },
    "error_details": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "project_id",
    "tenant_id",
    "definition_key",
    "primary_control_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}