{
  "name": "RemediationComment",
  "type": "object",
  "description": "A comment on an ACOLYTE remediation item. Client org users add comments through the org-scoped gatekeeper function only.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "remediation_item_id": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "author_role": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "remediation_item_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}