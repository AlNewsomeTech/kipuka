{
  "name": "ProjectSecurityTool",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "tool_name": {
      "type": "string",
      "enum": [
        "NinjaOne",
        "Palo Alto Cortex XDR",
        "PreVeil",
        "Microsoft Defender",
        "Microsoft Intune",
        "Microsoft Entra ID",
        "Microsoft Purview",
        "Other"
      ],
      "default": "NinjaOne"
    },
    "tool_status": {
      "type": "string",
      "enum": [
        "Not Used",
        "Planned",
        "Enabled",
        "In Review",
        "Disabled"
      ],
      "default": "Not Used"
    },
    "enabled_by": {
      "type": "string"
    },
    "enabled_date": {
      "type": "string",
      "format": "date"
    },
    "implementation_status": {
      "type": "string",
      "enum": [
        "Not Implemented",
        "Implemented"
      ],
      "default": "Not Implemented",
      "description": "Implemented means the configured tool can move its mapped controls to evidence collection. It does not complete assessment review."
    },
    "implemented_by": {
      "type": "string"
    },
    "implemented_date": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "admin_contact_name": {
      "type": "string"
    },
    "admin_contact_email": {
      "type": "string",
      "format": "email"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "tool_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}