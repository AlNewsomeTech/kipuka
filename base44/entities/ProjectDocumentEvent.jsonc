{
  "name": "ProjectDocumentEvent",
  "type": "object",
  "description": "Immutable audit event for a canonical ProjectDocument lifecycle transition. Created server-side after a verified transition and never updated or deleted.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_document_id": {
      "type": "string"
    },
    "template_key": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "Submitted for Review",
        "Changes Requested",
        "Resubmitted",
        "Approved",
        "Published",
        "Archived"
      ]
    },
    "from_status": {
      "type": "string"
    },
    "to_status": {
      "type": "string"
    },
    "transition_id": {
      "type": "string",
      "description": "Caller-supplied idempotency key unique to the intended transition."
    },
    "actor_user_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "document_sha256": {
      "type": "string"
    },
    "source_snapshot_sha256": {
      "type": "string"
    },
    "event_sha256": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "project_id",
    "project_document_id",
    "action",
    "transition_id",
    "event_sha256"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}