{
  "name": "SecurityReviewNote",
  "type": "object",
  "description": "Dated Pac-Sec analyst review notes for an ACOLYTE-serviced project. Client orgs read these through the org-scoped gatekeeper function only.",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "note_date": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string",
      "description": "Pac-Sec analyst name/email."
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "Client Visible",
        "Internal Only"
      ],
      "default": "Client Visible"
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "technician"
          }
        }
      ]
    }
  }
}