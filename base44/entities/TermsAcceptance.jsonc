{
  "name": "TermsAcceptance",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email"
    },
    "user_name": {
      "type": "string"
    },
    "terms_version": {
      "type": "string"
    },
    "accepted": {
      "type": "boolean",
      "default": false
    },
    "accepted_date": {
      "type": "string",
      "format": "date-time"
    },
    "declined_date": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "acceptance_text": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "terms_version"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "created_by_id": "{{user.id}}"
    }
  }
}