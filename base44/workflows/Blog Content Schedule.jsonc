{
  "description": "Writes one SEO article for the public Kipuka blog every Sunday, Tuesday, and Thursday at 7:00 AM. Takes the next topic from the Blog Topic queue, or the built-in keyword rotation when the queue is empty. A clean article publishes automatically. An article that fails the ASD-STE100 house style check is saved as a Draft for review instead.",
  "name": "Blog Content Schedule",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "blog_content_schedule",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "write_article": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateBlogArticle",
            "args": {
              "workflow_secret": "9f4c1e7a2d5b8036c4e9a1f7d3b60c85e2a749f0b1d6c38e5a07f4923cd8b16e"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Write blog article",
            "description": "Sun, Tue, Thu at 7 AM"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * 0,2,4",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_after_count": null,
      "ends_on_date": null
    }
  }
}